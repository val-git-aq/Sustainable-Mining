---
import { NAV, SITE, url } from '../lib/site';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">{SITE.name}</p>
      <p>
        {SITE.department}<br />
        {SITE.university}<br />
        {SITE.address.map((line) => (<>{line}<br /></>))}
      </p>
    </div>
    <div>
      <p class="footer-label">Contact</p>
      <p>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
        Office: {SITE.phone}
      </p>
    </div>
    <nav aria-label="Footer">
      <p class="footer-label">Explore</p>
      <ul class="plain-list">
        {NAV.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap footer-base">
    <p>© {new Date().getFullYear()} {SITE.name}, {SITE.university}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--nevada-deep);
    color: #dfe7ef;
    padding-top: 3rem;
    font-size: var(--step--1);
  }
  .site-footer a { color: #fff; }
  .footer-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .footer-name { font-size: var(--step-1); font-weight: 800; font-stretch: 112%; color: #fff; margin-bottom: 0.5rem; }
  .footer-label { font-weight: 700; color: #fff; margin-bottom: 0.4rem; }
  .footer-grid li { padding: 0.15rem 0; }
  .footer-base { border-top: 1px solid rgb(255 255 255 / 0.2); margin-top: 2rem; padding-block: 1rem; }
  .footer-base p { margin: 0; }
</style>
